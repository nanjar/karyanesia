# Development only. Copy to .env and supply your own database password.
DATABASE_URL=postgresql://karyanesia:CHANGE_ME@127.0.0.1:5432/karyanesia
POSTGRES_PASSWORD=CHANGE_ME
WEB_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development
# Run the web with the same value in apps/web/.env.local if not using its default.
API_INTERNAL_URL=http://127.0.0.1:4000
# 32 random bytes, encoded hex. Generate using: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# Bootstrap CLI only. Never commit populated values.
BOOTSTRAP_TENANT_CODE=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_EMPLOYEE_NUMBER=
BOOTSTRAP_FULL_NAME=
BOOTSTRAP_PASSWORD=

# Set only behind a trusted proxy that overwrites client forwarding headers.
TRUST_PROXY_HOPS=0

# Docker host ports; internal container ports stay unchanged.
# For a shared VPS, for example use 6401 / 6402 / 6432, and update WEB_ORIGIN.
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432

# Local demo only. Exact true/false. Default false; never enable in production.
DEMO=false
# Required when DEMO=true; choose a private password of 12–128 characters.
DEMO_PASSWORD=
